{
  "name": "subbuddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "dev:seller": "pnpm --filter @subbuddy/seller dev",
    "dev:api": "pnpm --filter @subbuddy/api dev",
    "dev:web": "pnpm --filter @subbuddy/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
