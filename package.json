{
  "name": "subbuddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm generate && pnpm -r run typecheck && tsc -p scripts && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm generate && vitest run",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "dev:hub": "node scripts/with-env.mjs pnpm --filter @subbuddy/hub dev",
    "dev:seller": "node scripts/with-env.mjs pnpm --filter @subbuddy/seller dev",
    "dev:api": "node scripts/with-env.mjs pnpm --filter @subbuddy/api dev",
    "dev:web": "node scripts/with-env.mjs pnpm --filter @subbuddy/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "postinstall": "pnpm generate",
    "generate": "pnpm --filter @subbuddy/database generate",
    "smoke:testnet": "node scripts/with-env.mjs tsx scripts/smoke-testnet.ts",
    "demo": "node scripts/with-env.mjs node scripts/demo.mjs",
    "fund:testnet": "node scripts/with-env.mjs tsx scripts/fund-testnet.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "xrpl": "4.6.0"
  }
}
