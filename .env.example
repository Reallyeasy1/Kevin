# SubBuddy runtime configuration. Copy to .env and fill in real values.
# Never commit .env. Wallet seeds and API keys live only in server-side env (SEC-002, INV-007).

# hackathon | development. While APP_ENV=hackathon, any Mainnet XRPL config fails startup (SEC-010).
APP_ENV=hackathon

# --- XRPL network (NFR-009) ---
# CAIP-2 network id used on the x402 wire. MUST equal x402-xrpl's Testnet id ("xrpl:1" in its XRPLNetworkId type; FR-020);
# the literal "xrpl:testnet" is not a valid wire value.
XRPL_NETWORK=xrpl:1
# Testnet websocket endpoint used by the payment adapter for ledger reads and tx resolution.
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233
# Explorer base for receipts; the tx hash is appended (FR-072).
XRPL_EXPLORER_BASE=https://testnet.xrpl.org/transactions/

# --- Settlement asset (DEC-004, DEC-005) ---
# RLUSD (default) or XRP (config-only fallback).
SETTLEMENT_ASSET=RLUSD
# Testnet RLUSD issuer address. Required when SETTLEMENT_ASSET=RLUSD.
RLUSD_ISSUER=rREPLACE_WITH_TESTNET_RLUSD_ISSUER
# 40-hex currency code for "RLUSD" carried on the wire (FR-020).
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000

# --- x402 facilitator (settles and submits to XRPL) ---
FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai

# --- Buyer (apps/api) ---
# Testnet agent wallet family seed. Read only at signing time, never logged or persisted (FR-070).
AGENT_WALLET_SEED=sREPLACE_WITH_TESTNET_SEED_NEVER_COMMIT
# Bearer key every /v1/routes and /execute call must present (SEC-011).
DEMO_API_KEY=replace-with-a-long-random-string
# Max total wallet spend per rolling hour, decimal string in SETTLEMENT_ASSET units (SEC-011).
HOURLY_SPEND_CAP=1.000000
# Mandate lifetime in seconds (FR-002).
MANDATE_TTL_SECONDS=300
# PostgreSQL connection (Prisma). Matches docker-compose.yml.
DATABASE_URL=postgresql://subbuddy:subbuddy@localhost:5432/subbuddy
# Buyer-side classifier credential (DEC-014). mock | anthropic | openai-compatible.
CLASSIFIER_PROVIDER=mock
CLASSIFIER_API_KEY=
# Optional for anthropic (default claude-opus-5); required with CLASSIFIER_BASE_URL for openai-compatible.
CLASSIFIER_MODEL=
CLASSIFIER_BASE_URL=

# --- Seller (apps/seller) --- separate secret set from the buyer (PRD §10.1)
# Where the buyer reaches the seller over HTTP (never in-process).
SELLER_BASE_URL=http://localhost:4020
# XRPL address that receives payments; must match the registry payTo for each offer.
SELLER_PAYTO_ADDRESS=rREPLACE_WITH_SELLER_TESTNET_ADDRESS
# mock | openai-compatible
SELLER_UPSTREAM_PROVIDER=mock
SELLER_UPSTREAM_BASE_URL=https://api.example.com/v1
# Upstream model key; exists only in seller-side env (FR-080).
SELLER_UPSTREAM_API_KEY=
